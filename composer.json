{
    "name": "abeon/sdk",
    "description": "Shared SDK for Abeon Unified microservices — auth, events, service-to-service HTTP, correlation, health.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "opis/json-schema": "^2.3",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Abeon\\SDK\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Abeon\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abeon\\SDK\\AbeonServiceProvider"
            ]
        },
        "abeon": {
            "event-schemas": "schemas/events"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
