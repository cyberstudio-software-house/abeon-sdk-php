{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abeon.pl/events/notification-requested.json",
  "title": "notification.requested payload",
  "description": "Payload for `*.notification.requested` events consumed by abeon-notifications. Per ADR-0006.",
  "type": "object",
  "required": ["target", "type", "title", "body", "source_app"],
  "properties": {
    "target": {
      "type": "object",
      "required": ["user_id"],
      "properties": {
        "user_id": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "type":       { "type": "string" },
    "title":      { "type": "string", "maxLength": 200 },
    "body":       { "type": "string", "maxLength": 2000 },
    "icon":       { "type": ["string", "null"] },
    "action_url": { "type": ["string", "null"] },
    "source_app": { "type": "string" },
    "metadata":   { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
