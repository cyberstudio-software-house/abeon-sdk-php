{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abeon.pl/events/cms.message.requested.json",
  "title": "cms.message.requested payload",
  "description": "The CMS's copy of the shared transactional-message payload (ADR-0030): the e-mail to a form's recipients, `cms.form_submission`. Each emitting service ships its own copy under its own routing key, because a wildcard cannot be a file name.",
  "type": "object",
  "required": [
    "template",
    "to",
    "idempotency_key"
  ],
  "properties": {
    "template": {
      "description": "Template name known to AbeonUnified, `{service}.{name}`.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "maxLength": 255
    },
    "to": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "user_id": {
          "description": "Set when the recipient already has an account.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "reply_to": {
      "description": "Where an answer goes, when not to the platform: the reader of a CMS form, so its recipients can answer them directly.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        }
      },
      "additionalProperties": false
    },
    "locale": {
      "type": "string",
      "enum": [
        "pl",
        "en"
      ]
    },
    "data": {
      "description": "Variables the template renders. Never a password.",
      "type": "object",
      "additionalProperties": true
    },
    "idempotency_key": {
      "description": "From the business fact that caused the message (`auth.invitation:1842`), never random — a redelivered event must not send a second mail.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  },
  "additionalProperties": false
}
