{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abeon.pl/dto/preferences.json",
  "title": "Abeon User Preferences",
  "description": "Versioned preferences blob stored per user in Auth service. Namespaced top-level keys; `chrome` is owned by the federated chrome. Per ADR-0009.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Server-controlled; incremented on breaking changes."
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinned": {
          "type": "array",
          "description": "Pinned sidebar items for this user in this organisation, across every application of the organisation.",
          "items": {
            "type": "object",
            "required": ["id", "app", "label", "href", "iconName", "sectionId", "order"],
            "additionalProperties": false,
            "properties": {
              "id":        { "type": "string", "minLength": 1, "description": "Unique across applications: `{app}.{item}`." },
              "app":       { "type": "string", "minLength": 1, "description": "AppDescriptor name of the application the item belongs to." },
              "label":     { "type": "string", "minLength": 1 },
              "href":      { "type": "string", "description": "The path as the owning application links to it. Another application opens it under that application's AppDescriptor path (a path already under it is kept)." },
              "iconName":  { "type": "string" },
              "sectionId": { "type": "string" },
              "order":     { "type": "integer", "minimum": 0 }
            }
          }
        },
        "pinnedSections": {
          "type": "array",
          "description": "Named sections of the pinned list, in display order. The section with id `default` always exists and needs no entry; an entry with that id only renames it. Removing a section moves its pins to `default`.",
          "items": {
            "type": "object",
            "required": ["id", "label", "order"],
            "additionalProperties": false,
            "properties": {
              "id":    { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "sidebarCollapsed": { "type": "boolean" },
        "recents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "ts"],
            "additionalProperties": true,
            "properties": {
              "id":    { "type": "string" },
              "title": { "type": "string" },
              "ts":    { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
