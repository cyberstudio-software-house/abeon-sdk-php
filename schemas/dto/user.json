{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abeon.pl/dto/user.json",
  "title": "Abeon User DTO",
  "type": "object",
  "required": [
    "id",
    "email",
    "roles",
    "permissions",
    "org_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "org_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "email_verified": {
      "description": "Whether the address has been verified (FR-4). Absent means the producer predates the flag.",
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
