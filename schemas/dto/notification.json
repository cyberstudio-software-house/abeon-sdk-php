{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abeon.pl/dto/notification.json",
  "title": "Abeon Notification DTO",
  "description": "Unified cross-app notification entity owned by abeon-notifications service. Per ADR-0006.",
  "type": "object",
  "required": ["id", "user_id", "type", "title", "body", "source_app", "created_at"],
  "properties": {
    "id":          { "type": "string", "format": "uuid" },
    "user_id":     { "type": "integer" },
    "type":        { "type": "string" },
    "title":       { "type": "string", "maxLength": 200 },
    "body":        { "type": "string", "maxLength": 2000 },
    "icon":        { "type": ["string", "null"] },
    "action_url":  { "type": ["string", "null"] },
    "source_app":  { "type": "string" },
    "read_at":     { "type": ["string", "null"], "format": "date-time" },
    "created_at":  { "type": "string", "format": "date-time" },
    "metadata":    { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
